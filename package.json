{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "notion-bookmark-capture",
  "title": "Notion Bookmark Capture",
  "description": "Capture Safari bookmarks to Notion Bookmarks database",
  "icon": "command-icon.png",
  "author": "ldangelo",
  "categories": [
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "bookmark-capture",
      "title": "Capture Bookmark",
      "description": "Save current Safari page to Notion Bookmarks",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.65.0",
    "@raycast/utils": "^1.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "jest"
  }
}
