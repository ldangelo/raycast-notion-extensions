{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "notion-bookmark-capture",
  "title": "Notion Bookmark Capture",
  "description": "Quickly capture Safari bookmarks to your Notion Bookmarks database with automatic URL and title detection",
  "icon": "command-icon.png",
  "author": "ldangelo",
  "categories": [
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "keywords": [
    "notion",
    "bookmarks",
    "safari",
    "mcp",
    "productivity",
    "capture",
    "web clipper"
  ],
  "commands": [
    {
      "name": "bookmark-capture",
      "title": "Capture Bookmark to Notion",
      "subtitle": "Bookmarks",
      "description": "Save current Safari page to Notion Bookmarks database with URL, title, and tags",
      "mode": "view",
      "keywords": [
        "bookmark",
        "save",
        "notion",
        "safari",
        "web",
        "clip"
      ]
    }
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@raycast/api": "^1.65.0",
    "@raycast/utils": "^1.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "jest"
  }
}
